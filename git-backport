#!/usr/bin/perl
#
# This backports work on a branch off main into
# earlier stable branches of moodle.

use strict;
use JSON::PP;

if (!$ARGV[0]) {

    print "git backport name-of-feature-of-main MOODLE_29_STABLE [more branches]\n";
    exit;

}

my $feature = shift @ARGV;
my @onto = @ARGV;

my $githubrepo = `git config --get user.github`;
chomp $githubrepo;

# Remotes: upstream to pull from, fork to push to (override via env)
my $upstream = $ENV{BACKPORT_UPSTREAM} || "upstream";
my $fork     = $ENV{BACKPORT_FORK}     || "origin";


print "Feature = $feature \n";
`git checkout $feature`;

my @failed;
my %jira_updates;   # field name => value

# Jira: auth via ~/.netrc (machine moodle.atlassian.net login EMAIL password API_TOKEN)
my $jira = $ENV{BACKPORT_JIRA} || "https://moodle.atlassian.net";
my ($issue) = $feature =~ /^(MDL-\d+)/i;
$issue = uc $issue if $issue;

sub jira_curl {
    my ($method, $path, $body) = @_;
    my @cmd = ('curl', '-sS', '-n', '-X', $method, '-H', 'Content-Type: application/json',
               '-w', "\n%{http_code}", "$jira$path");
    push @cmd, '-d', $body if defined $body;
    open(my $fh, '-|', @cmd) or return (0, '');
    local $/; my $out = <$fh>; close $fh;
    $out =~ s/\n(\d+)\z// or return (0, $out);
    return ($1, $out);
}

# "MOODLE_405_STABLE" => "4.5", "main" => "Master"
sub jira_version {
    my $b = shift;
    return 'Master' if $b eq 'main' || $b eq 'master';
    return ($1+0) . "." . ($2+0) if $b =~ /^MOODLE_(\d)(\d+)_STABLE$/;
    return undef;
}

# Lowercase and collapse whitespace (Jira names can contain double spaces)
sub norm { my $n = lc shift; $n =~ s/\s+/ /g; return $n; }

sub update_jira {
    my %u = @_;
    return unless $issue && %u;
    my ($code, $out) = jira_curl('GET', '/rest/api/2/field');
    if ($code != 200) { print "Jira: field lookup failed (HTTP $code), skipping update\n"; return; }
    my %id = map { (norm($_->{name}) => $_->{id}) } @{ decode_json($out) };
    my (%fields, $listed);
    foreach my $name (keys %u) {
        my $fid = $id{norm($name)};
        if (!$fid) {
            print "Jira: no custom field named '$name', skipping it\n";
            print "Jira: available pull fields: " . join(', ', sort grep { /pull|repo|branch/ } keys %id) . "\n" unless $listed++;
            next;
        }
        $fields{$fid} = $u{$name};
    }
    return unless %fields;

    # Compare against current values so we can report what actually changed
    ($code, $out) = jira_curl('GET', "/rest/api/2/issue/$issue?fields=" . join(',', keys %fields));
    my $current = $code == 200 ? (decode_json($out)->{fields} || {}) : {};
    my (%changed, @report);
    foreach my $name (sort keys %u) {
        my $fid = $id{norm($name)} or next;
        my $old = $current->{$fid};
        if (defined $old && $old eq $u{$name}) {
            push @report, "  unchanged: $name = $u{$name}";
        } else {
            $changed{$fid} = $u{$name};
            push @report, "  " . (defined $old && length $old ? "updated:   " : "set:       ") . "$name = $u{$name}"
                        . (defined $old && length $old ? " (was: $old)" : "");
        }
    }

    if (%changed) {
        ($code, $out) = jira_curl('PUT', "/rest/api/2/issue/$issue", encode_json({ fields => \%changed }));
        if ($code != 204) {
            print "Jira: update of $issue failed (HTTP $code): $out\n";
            return;
        }
    }
    print "\nJira $issue ($jira/browse/$issue):\n" . join("\n", @report) . "\n";
}

foreach my $onto (@onto) {

    my $ontobranch = $feature . '-' . $onto;
    my $cmd;
    print "Onto $onto $ontobranch \n";

    # Just make sure cherry pick state is clean
    $cmd = "git cherry-pick --abort";
    # print "$cmd\n"; `$cmd`;
    `$cmd`;
    print "-------------------------------------------------\n";

    # Jump onto main temporarily
    $cmd ="git checkout main";
    print "$cmd\n"; `$cmd`;
    print "-------------------------------------------------\n";

    # Make sure it's up to date
    $cmd ="git pull $upstream";
    print "$cmd\n"; `$cmd`;
    print "-------------------------------------------------\n";

    # Remove the backport branch if it exists
    $cmd ="git branch -D $ontobranch";
    print "$cmd\n"; `$cmd`;
    print "-------------------------------------------------\n";

    # Start a new branch from the stable branch
    $cmd = "git branch $ontobranch $upstream/$onto";
    print "$cmd\n"; `$cmd`;
    print "-------------------------------------------------\n";

    # Checkout new branch
    $cmd = "git checkout $ontobranch";
    print "$cmd\n"; `$cmd`;
    print "-------------------------------------------------\n";

    # `git pull upstream $ontobranch`;

    # Graft the diff new stuff on feature from main, onto new stable branch
    # `git rebase --onto $ontobranch $feature $upstream/$onto `;
    $cmd = "git cherry-pick main..$feature";
    print "$cmd\n"; print `$cmd 2>&1`;
    if ($? != 0) {
        print "\nERROR: cherry-pick onto $onto failed (conflict?). Aborting and skipping push.\n";
        `git cherry-pick --abort`;
        push @failed, $onto;
        print "-------------------------------------------------\n";
        next;
    }
    print "-------------------------------------------------\n";

    $cmd = "git push -f $fork";
    print "$cmd\n"; `$cmd`;

    my $url = "https://github.com/moodle/moodle/compare/$onto...$githubrepo:$ontobranch";
    print "\n\nDiff url $url\n\n";
    if (my $v = jira_version($onto)) {
        $jira_updates{"Pull $v Branch"}   = $ontobranch;
        $jira_updates{"Pull $v Diff URL"} = $url;
    } else {
        print "Jira: can't map $onto to a version, skipping\n";
    }
}

# Now go back to where we started
my $cmd = "git checkout $feature";
print "$cmd\n"; `$cmd`;
print "-------------------------------------------------\n";

# `git checkout $branch`;

if (%jira_updates) {
    $jira_updates{'Pull from Repository'} = "git\@github.com:$githubrepo/moodle.git";
    update_jira(%jira_updates);
}

if (@failed) {
    print "\nFAILED backports: " . join(', ', @failed) . "\n";
    exit 1;
}
